ENVIRONMENT=production

HOST=0.0.0.0
PORT=8080

# Timeouts
BACKEND_CALL_TIMEOUT_SECONDS=5.0
REQUEST_TIMEOUT_SECONDS=10.0

# Circuit breaker
CIRCUIT_BREAKER_FAIL_MAX=5
CIRCUIT_BREAKER_RESET_TIMEOUT_SECONDS=30.0

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_SEMANTIC_MATCHING=30/minute
RATE_LIMIT_TRANSLATE=30/minute

# Logging (optional feature — toggle on/off)
LOGGING_ENABLED=true
LOG_LEVEL=INFO
LOG_JSON=false

# Semantic matching backend: socket | mock
SEMANTIC_MATCHING_BACKEND=socket
SEMANTIC_MATCHING_BACKEND_HOST=localhost
SEMANTIC_MATCHING_BACKEND_PORT=9999

# Translation backend: socket | mock
# The real translation backend is being provided separately; only "mock"
# is included in this repo for local dev/testing.
TRANSLATION_BACKEND=socket
TRANSLATION_BACKEND_HOST=localhost
TRANSLATION_BACKEND_PORT=9998
